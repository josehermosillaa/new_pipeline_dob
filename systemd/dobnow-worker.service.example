[Unit]
Description=DOB NOW pipeline worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/dobnow/scraper_sec
ExecStart=/usr/bin/xvfb-run -a /opt/dobnow/venv/bin/python nuevo_pipeline/worker.py --db /opt/dobnow/data/state.sqlite --profile /opt/dobnow/data/chrome_profile --priorities A --pause-min 6 --pause-max 15 --block-threshold 3 --log-file /opt/dobnow/data/worker.log
Restart=on-failure
RestartSec=1800
SuccessExitStatus=0 4 130
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
